DATABASE_URL=postgresql://postgres.[YOUR-USERNAME]:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0
BACKEND_LIVE_URL=BACKEND LIVE URL + /api/v1/auth eg- https://EXAMPLE.COM/api/v1/auth/
BACKEND_LOCAL_URL=http://localhost:5050/api/v1/auth/
CLIENT_URL=https://EXAMPLE.COM
CLIENT__LOCAL_URL=http://localhost:3000
# Pass 7 — Payment System. Backend origin ONLY (no path) — used to build gateway
# return/webhook URLs, e.g. Telr's return_auth. Different from BACKEND_LIVE_URL/
# BACKEND_LOCAL_URL above, which already have /api/v1/auth/ baked in for email links.
BACKEND_ORIGIN=https://api.EXAMPLE.COM
BACKEND_ORIGIN_LOCAL=http://localhost:5050
# Razorpay (India / INR) — from the Razorpay Dashboard: Settings > API Keys.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# Settings > Webhooks > Add New Webhook — this is a value YOU set there, not generated.
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
# Telr (Kuwait / KWD) — from the Telr Merchant Administration System:
# Integrations > Payment Page V2 > Configuration.
TELR_STORE_ID=YOUR_TELR_STORE_ID
TELR_AUTH_KEY=YOUR_TELR_AUTH_KEY
TELR_TEST_MODE=true
