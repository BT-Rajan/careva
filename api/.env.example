DATABASE_URL=postgresql://postgres.[YOUR-USERNAME]:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0
BACKEND_LIVE_URL=BACKEND LIVE URL + /api/v1/auth eg- https://EXAMPLE.COM/api/v1/auth/
BACKEND_LOCAL_URL=http://localhost:5050/api/v1/auth/
CLIENT_URL=https://EXAMPLE.COM
CLIENT__LOCAL_URL=http://localhost:3000
# Pass 7 — Payment System. Backend origin ONLY (no path) — used to build gateway
# return/webhook URLs, e.g. Telr's return_auth. Different from BACKEND_LIVE_URL/
# BACKEND_LOCAL_URL above, which already have /api/v1/auth/ baked in for email links.
BACKEND_ORIGIN=https://api.EXAMPLE.COM
BACKEND_ORIGIN_LOCAL=http://localhost:5050
# Razorpay (India / INR) — from the Razorpay Dashboard: Settings > API Keys.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# Settings > Webhooks > Add New Webhook — this is a value YOU set there, not generated.
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
# Telr (Kuwait / KWD) — from the Telr Merchant Administration System:
# Integrations > Payment Page V2 > Configuration.
TELR_STORE_ID=YOUR_TELR_STORE_ID
TELR_AUTH_KEY=YOUR_TELR_AUTH_KEY
TELR_TEST_MODE=true
# Pass 9 — Cancellation & Rescheduling. Reasonable defaults, not a researched business
# policy — confirm/adjust with whoever owns pricing decisions. All optional; these are
# the fallback values if unset.
CANCELLATION_CUTOFF_HOURS=24
CANCELLATION_ON_TIME_REFUND_PERCENT=100
CANCELLATION_LATE_REFUND_PERCENT=50
PORT=5050
NODE_ENV=development
SHOW_ERROR_DETAILS=
# Pass 26 — Production Readiness SECURITY FIX: this line previously contained
# `f9Hr6v38sK2nA5xGt4wDcR7uJ1mZlP0b` — a specific 32-character random-looking string,
# used identically for BOTH JWT_SCRET and JWT_REFRESH_SECRET below, unlike every other
# value in this file (which are all obviously-fake placeholders like
# "YOUR_RAZORPAY_KEY_ID"). That specificity is exactly what a real, actually-used
# secret looks like, not a deliberate placeholder — and this file is committed to a
# public/shared repository. If any real deployment of this app has ever used that
# exact value as its live JWT_SCRET, its token-signing secret has been sitting in
# version control this whole time, and anyone who has seen this file could forge a
# valid, signed token for ANY user (including an admin) against that deployment. If
# you recognize that value as something you've actually used: rotate it immediately —
# generate a new secret and redeploy — this is not a "fix later" issue.
JWT_SCRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRED_IN=30d
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_STRING
DOCTOR_PASS=@doctor123
CLOUND_NAME=YOUR_CLOUD_NAME
API_KEY=YOUR_CLOUDINARY_API_KEY
API_SECRET=YOUR_CLOUDINARY_API_SECRET
EMAIL_PASS=YOUR_EMAIL_APP_PASSWORD_WITH_NO_SPACE
ADMIN_EMAIL=your_default_email@gmail.com
GMAIL_APP_EMAIL=your_email@gmail.com