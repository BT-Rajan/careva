generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE (Pass 2): Auth.userId is an intentional polymorphic reference — it points to
// either Patient.id or Doctor.id depending on `role`, and is null for admins. It is not
// converted to a real foreign key in this pass: doing so would change the JWT payload
// shape (`userId` is embedded directly in issued tokens) and cascade into every
// authenticated request across both the API and frontend. That is authentication/session
// surface, not database-integrity surface, and is deferred to Pass 3/4 as a deliberate
// decision rather than an oversight. See docs/passes/02-database-integrity.md.
model Auth {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  userId   String?
  role     UserRole
  /// When true (admin only): JWT marks user as demo; API blocks mutating requests (read-only).
  isDemo   Boolean  @default(false)

  /// Pass 3 — brute-force protection. Incremented on each failed login, reset on success.
  failedLoginAttempts Int       @default(0)
  /// Pass 3 — set when failedLoginAttempts crosses the threshold; login is refused while
  /// this is in the future, regardless of whether the password given is correct.
  lockedUntil         DateTime?

  @@map("Auth")
}

model UserVerfication {
  id     String @id @default(uuid())
  userId String
  uniqueString String?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForgotPassword {
  id     String @id @default(uuid())
  userId String
  uniqueString String?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("forgot-password")
}

model Patient {
  id           String         @id @default(uuid())
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  bloodGroup   String?
  mobile       String?
  city         String?
  state        String?
  zipCode      String?
  gender       String?
  country      String?
  email        String         @unique
  address      String?
  img          String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  /// Soft-delete scaffold (Pass 2). Not yet wired into service code — hard `delete()`
  /// calls remain until Pass 12 (Patient Data & Medical Records) owns the cutover.
  deletedAt    DateTime?
  appointments Appointments[]
  Reviews      Reviews[]
  Prescription Prescription[]
  favourites   Favourites[]

  @@map("Patient")
}

model Doctor {
  id                     String           @id @default(uuid())
  firstName              String
  lastName               String
  email                  String           @unique
  address                String?
  img                    String?
  phone                  String?
  gender                 Gender?
  dob                    String?
  biography              String?
  clinicName             String?
  clinicAddress          String?
  clinicImages           String?
  city                   String?
  state                  String?
  country                String?
  postalCode             String?
  price                  String?
  services               String?
  specialization         String?
  degree                 String?
  college                String?
  completionYear         String?
  experience             String?
  designation            String?
  award                  String?
  awardYear              String?
  registration           String?
  year                   String?
  experienceHospitalName String?
  expericenceStart       String?
  expericenceEnd         String?
  // Pass 10 — Doctor Lifecycle. `verified` means EMAIL verified only (unchanged meaning
  // and behavior — still gates login in auth.service.ts) — it never actually implied
  // admin approval in the schema, but nothing enforced a REAL approval gate either: a
  // never-reviewed doctor was fully bookable and fully public before this pass (see
  // docs/passes/10-doctor-lifecycle.md). approvalStatus is the separate concept the plan
  // calls for — see doctor-lifecycle.ts for the transition graph.
  verified               Boolean?         @default(false)
  approvalStatus            DoctorApprovalStatus @default(PENDING_APPROVAL)
  approvalStatusChangedAt   DateTime?
  approvalStatusChangedBy   String?
  approvalStatusChangeReason String?
  // Pass 7 — Payment System. Determines which regional payment gateway handles bookings
  // with this doctor: INR → Razorpay, KWD → Telr. Defaults to INR since that was the
  // implicit assumption everywhere before this pass (no currency concept existed at all).
  // Existing doctors need this set explicitly post-migration if any are actually
  // Kuwait-based — a default can't know that.
  currency               Currency         @default(INR)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  /// Soft-delete scaffold (Pass 2). Not yet wired into service code — hard `delete()`
  /// calls remain until Pass 10 (Doctor Lifecycle) owns the cutover.
  deletedAt              DateTime?
  appointments           Appointments[]
  prescription           Prescription[]
  favourites             Favourites[]
  DoctorTimeSlot         DoctorTimeSlot[]
  blockedDates           DoctorBlockedDate[]
  blogs                  Blogs[]
  reviews                Reviews[]

  // Pass 10: getAllDoctors (public listing) now filters on this every request.
  @@index([approvalStatus])
  @@map("Doctor")
}

model Appointments {
  id        String   @id @default(uuid())
  // Intentionally optional: guest/unauthenticated bookings have no linked Patient row
  // (see appointment.service.ts: createAppointmentByUnAuthenticateUser). This is
  // legitimate design, not a gap.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  // Was optional prior to Pass 2. Every code path that creates an appointment already
  // resolves a real doctor (falling back to config.defaultAdminDoctor for guest
  // bookings), so the column is made required to match actual behavior and close Gap G2
  // from docs/passes/01-domain-state-model.md.
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  trackingId         String?             @unique
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  address            String?
  description        String?
  scheduleDate       String?
  scheduleTime       String?
  reasonForVisit     String?
  // Pass 8 — Appointment State Machine. Was `String? @default("pending")` — an
  // unconstrained free-text column (Pass 1 §3.2 documented the real values actually
  // written: "pending", "scheduled", "cancel", and "Completed" — the last of which was
  // referenced in 4 frontend files but never once actually set by any code path). Now a
  // real enum; illegal values are a hard database-level rejection instead of a silent
  // typo. See docs/passes/08-appointment-state-machine.md for the legacy-string mapping
  // and the transition rules enforced in appointment-state-machine.ts.
  status             AppointmentStatus?  @default(PENDING)
  // Pass 8: lightweight per-row "last transition" audit — who moved this appointment to
  // its current status, when, and why. Full transition history goes to AuditLog (Pass 2)
  // as each transition happens; these three fields are just the fast/cheap "latest"
  // snapshot for display, not a replacement for the audit trail.
  statusChangedAt    DateTime?
  statusChangedBy    String?
  statusChangeReason String?
  paymentStatus      paymentStatus?      @default(unpaid)
  prescriptionStatus prescriptionStatus? @default(notIssued)
  isFollowUp         Boolean?            @default(false)
  patientType        String?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  /// Soft-delete scaffold (Pass 2). Appointments are historical/financial records and
  /// should never be hard-deleted going forward; wiring is Pass 8's job.
  deletedAt    DateTime?
  prescription Prescription[]
  payment      Payment[]
  // Pass 14 — Invoice & Financial Records.
  invoices     Invoice[]

  // Availability/lookup queries filter by doctor + date very frequently (booking flow,
  // doctor dashboard, admin dashboard) — this was previously an unindexed table scan.
  @@index([doctorId, scheduleDate])
  // Admin/doctor dashboards filter and count by status.
  @@index([status])
  @@map("Appointments")
}

model Payment {
  id            String       @id @default(uuid())
  appointmentId String
  appointment   Appointments @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  paymentMethod String
  paymentType   String

  // Pass 7 — Payment System. Previously this model had no status field at all, and
  // Appointments.paymentStatus was set to 'paid' unconditionally at booking time before
  // any gateway was even involved (Gap G6, docs/passes/01-domain-state-model.md) — this
  // is the real lifecycle. Matches the target model laid out in Pass 1 §4.3.
  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider
  currency Currency

  // DoctorFee/bookingFee/vat/totalAmount are now MINOR units (paise for INR — ×100;
  // fils for KWD — ×1000), not whole currency units, to avoid floating-point amounts and
  // to correctly represent KWD's 3-decimal-place currency. See api/src/shared/money.ts.
  DoctorFee   Int
  bookingFee  Int
  vat         Int?
  totalAmount Int

  // Gateway correlation. providerOrderId is set when a gateway order/session is created
  // (before the user pays); providerPaymentId is set once the gateway confirms an actual
  // payment attempt against that order — @unique because two Payment rows must never
  // both claim the same real-world gateway transaction.
  providerOrderId   String?
  providerPaymentId String? @unique
  // Raw signature/reference used for verification, kept for audit — never used as the
  // sole basis for trusting a payment; verification always re-derives and compares.
  providerSignature String?
  failureReason     String?
  // Running total refunded, in the same minor units as totalAmount. Compared against
  // totalAmount to distinguish REFUNDED (full) from PARTIALLY_REFUNDED.
  refundedAmount    Int?

  // Payment records had no timestamps at all prior to Pass 2 — no way to tell when a
  // payment was recorded or last touched. Added for audit-trail purposes; full financial
  // lifecycle (status, immutability enforcement) is Pass 7/14's job.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete scaffold (Pass 2). Financial records must never be hard-deleted; wiring
  /// is Pass 14's job.
  deletedAt DateTime?

  // Pass 14 — Invoice & Financial Records. See the Invoice model below: this is now a
  // list, not a nullable single relation, because paymentId on Invoice is NOT
  // database-unique — a corrected invoice shares its paymentId with the (now-VOID) row
  // it replaced (see the comment on Invoice.paymentId for why). Most Payment rows have
  // zero entries here — an Invoice is only created once the appointment reaches
  // SCHEDULED (see invoice.service.ts) — a Payment for a still-PENDING appointment
  // legitimately has none yet.
  invoices Invoice[]

  @@index([status])
  @@index([providerOrderId])
  @@map("Payment")
}

// Pass 7 — Payment System. Stores every inbound webhook/notification from a payment
// gateway, raw, before any processing. The @@unique below is the actual mechanism that
// makes webhook processing idempotent: a gateway retrying a notification (both Razorpay
// and Telr do this on anything other than a clean success response) hits this constraint
// on the retry and is safely recognized as already-seen rather than reprocessed.
model PaymentWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  // The gateway's own event/notification identifier (Razorpay: x-razorpay-event-id
  // header. Telr has no confirmed equivalent from the sources available while building
  // this — see docs/passes/07-payment-system.md — so the Telr path constructs a
  // synthetic id from the order ref + status instead of a true gateway-issued event id;
  // flagged there as needing verification against Telr's own docs).
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@map("PaymentWebhookEvent")
}

// Pass 14 — Invoice & Financial Records. Target model from
// docs/passes/01-domain-state-model.md §4.5: "Invoice becomes its own persisted,
// immutable record generated once an appointment reaches SCHEDULED ..., linked 1:1 with
// Payment, with DRAFT → ISSUED → PAID → VOID states. Corrections create a new invoice;
// existing ones are never edited in place."
//
// Trigger decision (left open by §4.5 as "SCHEDULED or COMPLETED, decision deferred"):
// **SCHEDULED**. An invoice documents an amount owed/paid for a confirmed booking — at
// PENDING nothing is confirmed yet (the doctor hasn't accepted), and waiting until
// COMPLETED (the medical visit itself) would delay billing until after the fact even
// though the charge is already fixed at booking time. SCHEDULED is the point the amount
// becomes final and the commitment is mutual (see invoice.service.ts's
// generateInvoiceForAppointment, called from appointment.service.ts's PENDING→SCHEDULED
// transition).
//
// DRAFT is deliberately not modeled, for the same reason Pass 13 didn't model
// Prescription's DRAFT: generation is fully automatic and atomic (computed instantly
// from the appointment's already-existing Payment at the moment of transition) — there
// is no partial/unfinished state for a human to ever leave one in. Flagged as a
// deliberate omission, not a silent one.
model Invoice {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointments @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  // 1:1-in-spirit with Payment, but NOT a DB-unique constraint on paymentId: a
  // corrected invoice (see supersedesId below) points at the SAME underlying payment as
  // the one it replaces — only the invoice document is versioned, not the money
  // movement it describes — so two Invoice rows CAN legitimately share a paymentId (one
  // VOID, one live). The real invariant — at most one non-VOID invoice per payment at a
  // time — is enforced in invoice.service.ts (generateInvoiceForAppointment's
  // existing-live-invoice guard, and correctInvoice always voiding the original before
  // creating the new row), not at the database level.
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  // Human-readable sequential number, same generation convention as
  // Appointments.trackingId (see invoice.service.ts) — distinct from the internal `id`,
  // which is what actually gets displayed/printed on the document.
  invoiceNumber String @unique

  status InvoiceStatus @default(ISSUED)

  // Snapshot of the charge at issuance time, in minor units (see api/src/shared/money.ts)
  // — copied from Payment rather than joined-and-trusted-live, because an invoice is
  // supposed to be an immutable record of what was charged AT THE TIME, even if the
  // underlying Payment row is later adjusted by a refund (refundedAmount changing on
  // Payment must never retroactively change what an already-issued invoice says it billed).
  currency    Currency
  doctorFee   Int
  bookingFee  Int
  vat         Int?
  totalAmount Int

  // Pass 14 correction/versioning — same pattern as Prescription's supersedesId (Pass
  // 13). A corrected invoice is never edited in place: the original transitions to
  // VOID (see invoice-lifecycle.ts — VOID is this model's only terminal "no longer
  // current" state, doing the job Prescription's separate CORRECTED status does there)
  // and a new Invoice row is created, linked back via supersedesId.
  supersedesId String?  @unique
  supersedes   Invoice? @relation("InvoiceCorrection", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Invoice? @relation("InvoiceCorrection")

  voidedAt     DateTime?
  voidedReason String?

  // Pass 14: deliberately no `deletedAt` here, unlike every other soft-deletable model
  // in this schema. VOID already IS this record's "does not count" state — an invoice
  // is either live (ISSUED/PAID) or superseded/cancelled (VOID); there is no additional
  // "and also hidden" state a financial document needs beyond that. Adding a second,
  // independent hide mechanism on top of VOID would just be two ways to say the same
  // thing.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentId])
  @@map("Invoice")
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model Reviews {
  id String @id @default(uuid())

  doctorId String
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  // Nullable: links a review back to the visit that justifies it (closes Gap G3 from
  // docs/passes/01-domain-state-model.md). Optional because existing reviews predate this
  // column and cannot be backfilled automatically; new reviews should populate it going
  // forward — enforcing that at the application layer is Pass 21's job (review
  // moderation), not this pass.
  appointmentId String?
  appointment   Appointments? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  description   String?
  star          String?
  isRecommended Boolean?
  response      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Reviews")
}

model Prescription {
  id String @id @default(uuid())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  appointmentId String
  appointment   Appointments @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  followUpdate String?
  instruction  String?
  daignosis    String?

  disease String
  test    String?

  // Pass 13 — Prescription & Treatment. Replaces the two independent booleans
  // (isFullfilled/isArchived) that existed before this pass. Neither was ever
  // reachable from any real UI action — the frontend mutation meant to set them
  // (prescriptionApi.js's `updatePrescription`) exported its hook under the wrong
  // RTK Query name (`useUpdatePrescriptionQuery` instead of the auto-generated
  // `useUpdatePrescriptionMutation` for a `build.mutation` endpoint), so the route had
  // been silently unreachable since it was written; no component ever called it. Real
  // lifecycle now enforced in prescription-lifecycle.ts, matching the target model in
  // docs/passes/01-domain-state-model.md §4.4.
  status PrescriptionStatus @default(ISSUED)

  // Pass 13 — correction/versioning. The target model's CORRECTED state means "create a
  // new linked version; original stays intact for audit" — a prescription is never
  // edited or deleted in place once issued. supersedesId points backwards from a
  // corrected version to the ISSUED/FULFILLED prescription it replaces; supersededBy is
  // the reverse lookup, letting any prescription report whether it has since been
  // corrected. See prescription.service.ts's updatePrescriptionAndAppointment, which is
  // the endpoint that actually performs a correction (see that function's own comment
  // for why it's not a separately-named function).
  supersedesId String?       @unique
  supersedes   Prescription? @relation("PrescriptionCorrection", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Prescription? @relation("PrescriptionCorrection")

  medicines Medicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete (Pass 2 scaffold, wired in Pass 13). Prescriptions are medical/legal
  /// records and are never hard-deleted — see prescription.service.ts's
  /// deletePrescription (soft) / reactivatePrescription (admin-only restore).
  deletedAt DateTime?

  @@index([status])
  @@map("Prescription")
}

// Pass 13 — Prescription & Treatment. The target lifecycle from
// docs/passes/01-domain-state-model.md §4.4:
//
//   ISSUED → FULFILLED
//      ↓        ↓
//   CORRECTED (new linked version; original row flips to CORRECTED and stays intact)
//
//   ISSUED / FULFILLED → ARCHIVED   (visibility only — does not erase history)
//
// DRAFT is deliberately not modeled: every real code path creates a prescription
// already-complete, atomically with the appointment's → COMPLETED transition (Pass 12)
// — there is no partial-save UI anywhere that would ever leave a row in a draft state,
// and adding an unused enum value/scaffold for it would be exactly the kind of
// speculative surface Careva's hardening passes have been removing, not adding. Flagged
// here as a deliberate omission rather than a silent one.
enum PrescriptionStatus {
  ISSUED
  FULFILLED
  CORRECTED
  ARCHIVED
}

model Medicine {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicine  String?
  dosage    String?
  frequency String?
  duration  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Medicine")
}

model Favourites {
  id String @id @default(uuid())

  // Previously `doctorId String @unique`, which meant only ONE favourite row could exist
  // per doctor system-wide — the first patient to favourite a doctor silently blocked
  // every other patient from ever favouriting that same doctor (Gap G4 from
  // docs/passes/01-domain-state-model.md; confirmed live in favourites.service.ts, whose
  // "already favourited" check queries by doctorId alone). Replaced with a composite
  // unique constraint expressing the actual intended rule: a given patient can favourite
  // a given doctor at most once, and many patients can favourite the same doctor.
  // patientId is also made required — a favourite with no owning patient is meaningless.
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("Favourites")
}

model DoctorTimeSlot {
  id String @id @default(uuid())

  doctorId       String
  doctor         Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  day            Day?
  timeSlot       ScheduleDay[]
  weekDay        String?
  maximumPatient Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("DoctorTimeSlot")
}

model ScheduleDay {
  id               Int             @id @default(autoincrement())
  startTime        String
  endTime          String
  doctorTimeSlot   DoctorTimeSlot? @relation(fields: [doctorTimeSlotId], references: [id], onDelete: Cascade)
  doctorTimeSlotId String?
}

// Pass 11 — Doctor Schedule Engine. Flagged as a gap since Pass 5 ("no doctor holidays /
// one-off unavailable dates — DoctorTimeSlot only models a recurring weekly pattern").
// `date` is a calendar date (stored as the same String-based convention as
// Appointments.scheduleDate, for consistent comparison logic), distinct from the
// recurring `day` (weekday) on DoctorTimeSlot — this blocks one specific date
// (a holiday, a day of leave) without touching the recurring weekly template at all.
model DoctorBlockedDate {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([doctorId, date])
  @@map("DoctorBlockedDate")
}

model Blogs {
  id          String   @id @default(uuid())
  title       String
  description String
  img         String?
  userId      String
  user        Doctor   @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Pass 2 scaffolding tables -----------------------------------------------------
// These two tables are added now because Pass 2's own scope explicitly calls for
// "Idempotency records" and "Audit records" as database-integrity concerns. Neither is
// wired into application code in this pass — no service currently reads or writes them.
// IdempotencyKey is consumed starting in Pass 20 (Concurrency & Idempotency).
// AuditLog is consumed starting in Pass 22 (Audit & Observability).
// Defining the shape now (rather than later) means every intermediate pass that touches
// mutating endpoints can be written idempotency/audit-aware from the start instead of
// being retrofitted.

model IdempotencyKey {
  /// Client-supplied idempotency key (e.g. an `Idempotency-Key` request header).
  key         String   @id
  /// Cached response body, replayed verbatim if the same key is seen again.
  response    Json?
  statusCode  Int?
  createdAt   DateTime @default(now())

  @@map("IdempotencyKey")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("AuditLog")
}

enum UserRole {
  admin
  patient
  doctor
}

enum Day {
  saturday
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
}

enum Gender {
  male
  female
}

enum prescriptionStatus {
  issued
  notIssued
}

enum paymentStatus {
  paid
  unpaid
}

// Pass 7 — Payment System. India and Kuwait are Careva's two markets. KWD is a
// 3-decimal-place currency (1000 fils = 1 KWD) — see api/src/shared/money.ts for why
// that matters for how amounts are stored.
// Pass 8 — Appointment State Machine. The target model from
// docs/passes/01-domain-state-model.md §4.2, now actually implemented — see
// appointment-state-machine.ts for the transition table and per-transition
// authorization (who may perform which move).
// Pass 10 — Doctor Lifecycle. See doctor-lifecycle.ts for the transition graph and who
// may trigger each move. PENDING_APPROVAL is the default for every newly registered
// doctor — email verification (the separate `verified` boolean) does not change this;
// admin review is a distinct, required step.
enum DoctorApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  DECLINED
  EXPIRED
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  CANCELLED_BY_ADMIN
  NO_SHOW
}

enum Currency {
  INR
  KWD
}

enum PaymentProvider {
  razorpay
  telr
}

// Pass 7 — Payment System. The target lifecycle from docs/passes/01-domain-state-model.md
// §4.3, now actually implemented rather than just specified.
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  // Set when a webhook and a server-side verification call disagree, or when a gateway
  // call errors in a way that leaves the real state unknown (e.g. timeout after the
  // request may have already been processed gateway-side). Never silently resolved to a
  // guess — see payment.service.ts reconcilePayment.
  UNKNOWN_RECONCILING
}
