generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE (Pass 2): Auth.userId is an intentional polymorphic reference — it points to
// either Patient.id or Doctor.id depending on `role`, and is null for admins. It is not
// converted to a real foreign key in this pass: doing so would change the JWT payload
// shape (`userId` is embedded directly in issued tokens) and cascade into every
// authenticated request across both the API and frontend. That is authentication/session
// surface, not database-integrity surface, and is deferred to Pass 3/4 as a deliberate
// decision rather than an oversight. See docs/passes/02-database-integrity.md.
model Auth {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  userId   String?
  role     UserRole
  /// When true (admin only): JWT marks user as demo; API blocks mutating requests (read-only).
  isDemo   Boolean  @default(false)

  @@map("Auth")
}

model UserVerfication {
  id     String @id @default(uuid())
  userId String
  uniqueString String?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForgotPassword {
  id     String @id @default(uuid())
  userId String
  uniqueString String?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("forgot-password")
}

model Patient {
  id           String         @id @default(uuid())
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  bloodGroup   String?
  mobile       String?
  city         String?
  state        String?
  zipCode      String?
  gender       String?
  country      String?
  email        String         @unique
  address      String?
  img          String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  /// Soft-delete scaffold (Pass 2). Not yet wired into service code — hard `delete()`
  /// calls remain until Pass 12 (Patient Data & Medical Records) owns the cutover.
  deletedAt    DateTime?
  appointments Appointments[]
  Reviews      Reviews[]
  Prescription Prescription[]
  favourites   Favourites[]

  @@map("Patient")
}

model Doctor {
  id                     String           @id @default(uuid())
  firstName              String
  lastName               String
  email                  String           @unique
  address                String?
  img                    String?
  phone                  String?
  gender                 Gender?
  dob                    String?
  biography              String?
  clinicName             String?
  clinicAddress          String?
  clinicImages           String?
  city                   String?
  state                  String?
  country                String?
  postalCode             String?
  price                  String?
  services               String?
  specialization         String?
  degree                 String?
  college                String?
  completionYear         String?
  experience             String?
  designation            String?
  award                  String?
  awardYear              String?
  registration           String?
  year                   String?
  experienceHospitalName String?
  expericenceStart       String?
  expericenceEnd         String?
  verified               Boolean?         @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  /// Soft-delete scaffold (Pass 2). Not yet wired into service code — hard `delete()`
  /// calls remain until Pass 10 (Doctor Lifecycle) owns the cutover.
  deletedAt              DateTime?
  appointments           Appointments[]
  prescription           Prescription[]
  favourites             Favourites[]
  DoctorTimeSlot         DoctorTimeSlot[]
  blogs                  Blogs[]
  reviews                Reviews[]

  @@map("Doctor")
}

model Appointments {
  id        String   @id @default(uuid())
  // Intentionally optional: guest/unauthenticated bookings have no linked Patient row
  // (see appointment.service.ts: createAppointmentByUnAuthenticateUser). This is
  // legitimate design, not a gap.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  // Was optional prior to Pass 2. Every code path that creates an appointment already
  // resolves a real doctor (falling back to config.defaultAdminDoctor for guest
  // bookings), so the column is made required to match actual behavior and close Gap G2
  // from docs/passes/01-domain-state-model.md.
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  trackingId         String?             @unique
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  address            String?
  description        String?
  scheduleDate       String?
  scheduleTime       String?
  reasonForVisit     String?
  status             String?             @default("pending")
  paymentStatus      paymentStatus?      @default(unpaid)
  prescriptionStatus prescriptionStatus? @default(notIssued)
  isFollowUp         Boolean?            @default(false)
  patientType        String?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  /// Soft-delete scaffold (Pass 2). Appointments are historical/financial records and
  /// should never be hard-deleted going forward; wiring is Pass 8's job.
  deletedAt    DateTime?
  prescription Prescription[]
  payment      Payment[]

  // Availability/lookup queries filter by doctor + date very frequently (booking flow,
  // doctor dashboard, admin dashboard) — this was previously an unindexed table scan.
  @@index([doctorId, scheduleDate])
  // Admin/doctor dashboards filter and count by status.
  @@index([status])
  @@map("Appointments")
}

model Payment {
  id            String       @id @default(uuid())
  appointmentId String
  appointment   Appointments @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  paymentMethod String
  paymentType   String

  DoctorFee   Int
  bookingFee  Int
  vat         Int?
  totalAmount Int

  // Payment records had no timestamps at all prior to Pass 2 — no way to tell when a
  // payment was recorded or last touched. Added for audit-trail purposes; full financial
  // lifecycle (status, immutability enforcement) is Pass 7/14's job.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete scaffold (Pass 2). Financial records must never be hard-deleted; wiring
  /// is Pass 14's job.
  deletedAt DateTime?

  @@map("Payment")
}

model Reviews {
  id String @id @default(uuid())

  doctorId String
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  // Nullable: links a review back to the visit that justifies it (closes Gap G3 from
  // docs/passes/01-domain-state-model.md). Optional because existing reviews predate this
  // column and cannot be backfilled automatically; new reviews should populate it going
  // forward — enforcing that at the application layer is Pass 21's job (review
  // moderation), not this pass.
  appointmentId String?
  appointment   Appointments? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  description   String?
  star          String?
  isRecommended Boolean?
  response      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Reviews")
}

model Prescription {
  id String @id @default(uuid())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  appointmentId String
  appointment   Appointments @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  followUpdate String?
  instruction  String?
  isFullfilled Boolean @default(false)
  isArchived   Boolean @default(false)
  daignosis    String?

  disease String
  test    String?

  medicines Medicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete scaffold (Pass 2). Prescriptions are medical/legal records and should
  /// never be hard-deleted going forward; wiring is Pass 13's job.
  deletedAt DateTime?

  @@map("Prescription")
}

model Medicine {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicine  String?
  dosage    String?
  frequency String?
  duration  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Medicine")
}

model Favourites {
  id String @id @default(uuid())

  // Previously `doctorId String @unique`, which meant only ONE favourite row could exist
  // per doctor system-wide — the first patient to favourite a doctor silently blocked
  // every other patient from ever favouriting that same doctor (Gap G4 from
  // docs/passes/01-domain-state-model.md; confirmed live in favourites.service.ts, whose
  // "already favourited" check queries by doctorId alone). Replaced with a composite
  // unique constraint expressing the actual intended rule: a given patient can favourite
  // a given doctor at most once, and many patients can favourite the same doctor.
  // patientId is also made required — a favourite with no owning patient is meaningless.
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("Favourites")
}

model DoctorTimeSlot {
  id String @id @default(uuid())

  doctorId       String
  doctor         Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  day            Day?
  timeSlot       ScheduleDay[]
  weekDay        String?
  maximumPatient Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("DoctorTimeSlot")
}

model ScheduleDay {
  id               Int             @id @default(autoincrement())
  startTime        String
  endTime          String
  doctorTimeSlot   DoctorTimeSlot? @relation(fields: [doctorTimeSlotId], references: [id], onDelete: Cascade)
  doctorTimeSlotId String?
}

model Blogs {
  id          String   @id @default(uuid())
  title       String
  description String
  img         String?
  userId      String
  user        Doctor   @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Pass 2 scaffolding tables -----------------------------------------------------
// These two tables are added now because Pass 2's own scope explicitly calls for
// "Idempotency records" and "Audit records" as database-integrity concerns. Neither is
// wired into application code in this pass — no service currently reads or writes them.
// IdempotencyKey is consumed starting in Pass 20 (Concurrency & Idempotency).
// AuditLog is consumed starting in Pass 22 (Audit & Observability).
// Defining the shape now (rather than later) means every intermediate pass that touches
// mutating endpoints can be written idempotency/audit-aware from the start instead of
// being retrofitted.

model IdempotencyKey {
  /// Client-supplied idempotency key (e.g. an `Idempotency-Key` request header).
  key         String   @id
  /// Cached response body, replayed verbatim if the same key is seen again.
  response    Json?
  statusCode  Int?
  createdAt   DateTime @default(now())

  @@map("IdempotencyKey")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("AuditLog")
}

enum UserRole {
  admin
  patient
  doctor
}

enum Day {
  saturday
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
}

enum Gender {
  male
  female
}

enum prescriptionStatus {
  issued
  notIssued
}

enum paymentStatus {
  paid
  unpaid
}
